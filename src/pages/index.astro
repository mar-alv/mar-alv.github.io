---
import { BounceIcons } from '@/components/bounce-icons'
import Layout from '@/layouts/Layout.astro'
import '@/styles/globals.css'
---

<!--
	- TODO: create 404 page
-->
<Layout title='Marcelo Alvarez - Home'>
  <main
    class='h-full flex flex-wrap justify-center items-center md:justify-between'
  >
    <div>
      <h1 class='flex text-3xl'>
        Hey! I'm Marcelo<BounceIcons icons={['🍯', '☀️', '🍊']} client:load />
      </h1>
      <p class='max-w-md text-5xl'>
        Coding in the sunshine, fueled by caffeine—where creativity meets
        functionality.
      </p>
    </div>

    <img
      src='avatar.svg'
      alt='Caricature-style self-portrait of me, smiling and waving my right hand. My left hand is resting on the edge of a circular border that surrounds the caricature. I am wearing a white shirt, and my dark blonde curly hair is visible. The entire illustration is done in white and brown tones, creating a minimalist, warm aesthetic.'
      class='size-80 rounded-full'
    />
  </main>
</Layout>
